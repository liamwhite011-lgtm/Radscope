<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#05080b">
<title>RADSCOPE // Community Radiation Map</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{--bg:#05080b;--panel:#0a1118;--line:#1b2c38;--text:#eef8ff;--muted:#8195a3;--green:#64ffb0;--blue:#58b7ff;--yellow:#ffe149;--orange:#ff951f;--red:#ff4242}
*{box-sizing:border-box}html,body,#app{margin:0;width:100%;height:100%;height:100dvh;overflow:hidden}
body{background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
#app{display:flex;flex-direction:column}header{height:65px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 13px;background:#061018;border-bottom:1px solid var(--line);z-index:20}
.brand{display:flex;align-items:center;gap:10px}.logo{width:36px;height:36px;border:1px solid #285c48;border-radius:11px;display:grid;place-items:center;color:var(--green);font-size:19px}.title{font-size:13px;font-weight:950;letter-spacing:.08em}.sub{font-size:8px;color:var(--muted);margin-top:2px}.status{font-size:8px;font-weight:950;color:var(--green)}
main{flex:1;min-height:0;position:relative}.screen{display:none;width:100%;height:100%}.screen.active{display:block}.panel{height:100%;overflow:auto;padding:14px;background:radial-gradient(circle at 90% 0,rgba(88,183,255,.07),transparent 30%),var(--bg)}
#mapScreen{position:relative;background:#081018}#map{position:absolute;inset:0;z-index:1}
.hud{position:absolute;z-index:5;left:10px;right:10px;top:10px;display:flex;justify-content:space-between;pointer-events:none;gap:8px}.hudbox{background:rgba(4,10,14,.90);border:1px solid #29404e;border-radius:12px;padding:8px 10px;backdrop-filter:blur(10px);font-size:8px;font-weight:900;box-shadow:0 10px 25px #0005}.hudbox small{display:block;color:#8fa2ae;font-size:7px;margin-top:3px}.live{color:var(--green)}
.mapBtns{position:absolute;z-index:5;right:10px;top:95px;display:grid;gap:7px}.mapBtns button,.quick{border:1px solid #2a4657;background:rgba(4,10,14,.92);color:white;border-radius:11px;font-weight:900}.mapBtns button{width:42px;height:42px;font-size:17px}.quickbar{position:absolute;z-index:5;left:10px;right:10px;bottom:10px;display:flex;gap:7px;overflow:auto}.quick{padding:10px 12px;white-space:nowrap;font-size:8px}
.hero{border:1px solid #203440;background:linear-gradient(135deg,#0b151c,#081018);border-radius:17px;padding:15px;margin-bottom:11px}.kicker{font-size:8px;color:var(--green);font-weight:950;letter-spacing:.13em}.hero h1{font-size:21px;line-height:1.05;margin:6px 0}.hero p,.note{font-size:9px;line-height:1.55;color:#9fb0bb}.card{background:#0a1118e8;border:1px solid var(--line);border-radius:14px;padding:13px;margin-bottom:10px}.card h2{font-size:10px;text-transform:uppercase;letter-spacing:.08em;margin:0 0 9px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.stats{font-size:8px;color:var(--muted)}.stats b{display:block;color:white;font-size:18px;margin-top:4px}
.btn{width:100%;padding:11px;border:1px solid #274250;border-radius:11px;background:#0a131a;color:white;font-size:9px;font-weight:900}.btn.green{border-color:#2b6c50;background:#0a1812}.btn:disabled{opacity:.45}
input,select{width:100%;padding:11px;border-radius:10px;border:1px solid #29404e;background:#071018;color:white;outline:none;font-size:9px}.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.upload{border:1px dashed #36596b;border-radius:13px;padding:18px;text-align:center;background:#071018}.upload strong{display:block;font-size:10px}.upload span{display:block;color:var(--muted);font-size:8px;margin-top:5px}
.list{display:grid;gap:7px}.item{display:flex;justify-content:space-between;gap:8px;align-items:center;padding:10px;border:1px solid #1c313d;border-radius:11px;background:#081118}.item b{font-size:9px}.item span{font-size:8px;color:var(--muted)}
table{width:100%;border-collapse:collapse;font-size:8px}th,td{padding:7px 5px;border-bottom:1px solid #182a35;text-align:left}th{color:#8da1ad}
nav{height:66px;height:calc(66px + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);flex:none;display:grid;grid-template-columns:repeat(3,1fr);background:#061018;border-top:1px solid var(--line);z-index:20}nav button{border:0;background:transparent;color:#677b89;font-size:8px;font-weight:900}nav button span{display:block;font-size:18px;margin-bottom:3px}nav button.active{color:white;background:#64ffb00d}
#toast{position:fixed;z-index:100;left:50%;bottom:82px;transform:translateX(-50%) translateY(20px);opacity:0;pointer-events:none;background:#071018;border:1px solid #2d4858;border-radius:999px;padding:10px 13px;font-size:8px;transition:.25s;white-space:nowrap;box-shadow:0 12px 30px #0008}#toast.show{opacity:1;transform:translateX(-50%)}
#setupOverlay{position:fixed;inset:0;background:#05080b;z-index:999;display:none;align-items:center;justify-content:center;padding:18px}.setupCard{max-width:520px;width:100%;background:#0a1118;border:1px solid #29404e;border-radius:18px;padding:18px;box-shadow:0 20px 60px #000b}.setupCard h2{margin:0 0 6px;font-size:17px}.setupCard p{font-size:9px;line-height:1.55;color:#96a9b5}.setupCard code{font-size:8px;color:#bfe9d1}.setupCard label{display:block;font-size:8px;color:#9aabb5;margin:10px 0 5px}
.leaflet-control-zoom a{background:#071018!important;color:white!important;border-color:#29404e!important}.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:#071018;color:white}.leaflet-popup-content{font-size:10px}.popupTitle{font-weight:950;margin-bottom:5px}.popupValue{font-size:18px;font-weight:950;color:#64ffb0}.popupMeta{font-size:8px;color:#9fb0bb;margin-top:4px}
@media(min-width:800px){.panel{padding:22px}.card,.hero{max-width:900px;margin-left:auto;margin-right:auto}}
</style>
</head>
<body>
<div id="app">
<header><div class="brand"><div class="logo">☢</div><div><div class="title">RADSCOPE // COMMUNITY</div><div class="sub">SHARED USER RADIATION DATA</div></div></div><div class="status" id="status">CLOUD OFFLINE</div></header>

<main>
<section id="mapScreen" class="screen active">
<div id="map"></div>
<div class="hud">
  <div class="hudbox">☢ COMMUNITY RADAR<small id="hudSub">SHARED DATA • µSv/h</small></div>
  <div class="hudbox"><span class="live">● <span id="onlineText">LOCAL</span></span><small id="lastSync">waiting for cloud</small></div>
</div>
<div class="mapBtns"><button id="locate">⌖</button><button id="fit">⊙</button><button id="refresh">↻</button></div>
<div class="quickbar"><button class="quick" id="goData">⇧ UPLOAD</button><button class="quick" id="export">⇩ EXPORT</button><button class="quick" id="sample">＋ SAMPLE</button></div>
</section>

<section id="dataScreen" class="screen panel">
<div class="hero"><div class="kicker">CLOUD DATASET</div><h1>Upload it. Share it.</h1><p>Measurements imported here are sent to the shared RADSCOPE database after cloud setup. Other people using the same app can receive new readings in real time.</p></div>

<div class="card">
<h2>Import measurements</h2>
<div class="upload"><strong>Choose a CSV or JSON file</strong><span>Required: latitude, longitude, radiation. Optional: time, unit, device, note.</span><input id="fileInput" type="file" accept=".csv,.json,text/csv,application/json" style="margin-top:12px"></div>
</div>

<div class="card">
<h2>Expected CSV</h2>
<table><thead><tr><th>latitude</th><th>longitude</th><th>radiation</th><th>unit</th><th>time</th></tr></thead><tbody><tr><td>43.38</td><td>-79.76</td><td>0.11</td><td>µSv/h</td><td>2026-09-21T18:00:00Z</td></tr></tbody></table>
<p class="note">The importer recognizes common variations such as lat/latitude, lon/lng/longitude, value/radiation/dose, and time/timestamp.</p>
</div>

<div class="card">
<h2>Manual reading</h2>
<div class="row"><input id="lat" type="number" step="any" placeholder="Latitude"><input id="lon" type="number" step="any" placeholder="Longitude"></div>
<div class="row" style="margin-top:8px"><input id="rad" type="number" step="any" placeholder="Radiation value"><select id="unit"><option>µSv/h</option><option>CPM</option><option>CPS</option></select></div>
<input id="device" placeholder="Device / note (optional)" style="margin-top:8px">
<button class="btn green" id="addManual" style="margin-top:8px">＋ SAVE TO SHARED MAP</button>
</div>

<div class="card">
<h2>Cloud status</h2>
<div class="list">
<div class="item"><b>Database</b><span id="dbState">Not configured</span></div>
<div class="item"><b>Shared readings</b><span id="cloudCount">0</span></div>
<div class="item"><b>Realtime</b><span id="rtState">Off</span></div>
</div>
</div>

<div class="card">
<h2>Exports</h2><button class="btn" id="downloadCsv">⇩ DOWNLOAD SHARED DATASET</button>
</div>
</section>

<section id="settingsScreen" class="screen panel">
<div class="hero"><div class="kicker">CLOUD SETTINGS</div><h1>Your project.</h1><p>Connect this file to your own Supabase project. The browser uses the public/publishable client key; database permissions are enforced with Row Level Security.</p></div>

<div class="card">
<h2>Supabase connection</h2>
<div class="list">
<div class="item"><b>Project</b><span>RADSCOPE • Canada</span></div>
<div class="item"><b>Database</b><span>radiation_readings</span></div>
<div class="item"><b>Public key</b><span>Configured</span></div>
<div class="item"><b>RLS</b><span>Enabled</span></div>
</div>
<button class="btn green" id="connect" style="margin-top:10px">CONNECT / RESYNC CLOUD</button>
<button class="btn" id="disconnect" style="margin-top:7px">USE LOCAL MODE</button>
<p class="note">The browser uses a Supabase publishable key. The database's Row Level Security policies control what clients can read and write.</p>
</div>

<div class="card">
<h2>Recommended architecture</h2>
<div class="list">
<div class="item"><b>Database</b><span>Postgres</span></div>
<div class="item"><b>Users</b><span>Anonymous sessions</span></div>
<div class="item"><b>Map</b><span>OpenStreetMap basemap</span></div>
<div class="item"><b>Radiation layer</b><span>Community data only</span></div>
</div>
</div>
</section>
</main>

<nav><button class="active" data-screen="mapScreen"><span>◎</span>Radar</button><button data-screen="dataScreen"><span>⇧</span>My Data</button><button data-screen="settingsScreen"><span>⚙</span>Cloud</button></nav>
<div id="toast"></div>

<div id="setupOverlay"><div class="setupCard">
<h2>☁ One quick Supabase setting</h2>
<p>The RADSCOPE database is already created and secured. This browser build uses anonymous Supabase accounts so people can upload without entering personal information.</p>
<p><b>Enable Anonymous Sign-Ins:</b> open your Supabase project → <b>Authentication → Providers</b> → turn on <b>Anonymous Sign-Ins</b>. Then return to RADSCOPE and tap <b>CONNECT / RESYNC CLOUD</b>.</p>
<p>Supabase documents that anonymous users receive the <code>authenticated</code> role, which lets the RLS policies on this project protect uploads while still allowing shared reads. urlSupabase anonymous sign-ins docshttps://supabase.com/docs/guides/auth/auth-anonymous</p>
<p><b>Privacy:</b> readings are shared with users of this RADSCOPE project. Do not put names, addresses, or other personal information in device/note fields.</p>
<button class="btn green" onclick="document.getElementById('setupOverlay').style.display='none'">GOT IT</button>
</div></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const CONFIG_KEY='radscope_cloud_config_v2';
const PROJECT_URL='https://gdjxfyilrggnukayclkq.supabase.co';
const PUBLISHABLE_KEY='sb_publishable_uVpRX852149Any3v7cG3hw_qGV4Jtyf';
let readings=[], supabase=null, realtimeChannel=null, low=.3, high=1;
const map=L.map('map',{zoomControl:false,preferCanvas:true}).setView([43.45,-79.75],9);
L.control.zoom({position:'bottomright'}).addTo(map);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'© OpenStreetMap contributors'}).addTo(map);
const layer=L.layerGroup().addTo(map);

function toast(s){const t=document.getElementById('toast');t.textContent=s;t.classList.add('show');clearTimeout(window.tt);window.tt=setTimeout(()=>t.classList.remove('show'),2500)}
function color(v){if(v<low)return '#20e66c';if(v<high)return '#ffe149';if(v<5)return '#ff951f';return '#ff4242'}
function escapeHtml(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function normalizeRow(r){
  const obj={};Object.keys(r||{}).forEach(k=>obj[k.toLowerCase().replace(/[^\w]/g,'')]=r[k]);
  const pick=names=>{for(const n of names){const k=n.toLowerCase().replace(/[^\w]/g,'');if(obj[k]!==undefined&&obj[k]!==''&&obj[k]!==null)return obj[k]}return null};
  const lat=Number(pick(['lat','latitude','y'])),lon=Number(pick(['lon','lng','longitude','long','x'])),value=Number(pick(['radiation','radiationvalue','usvh','usvph','dose','dosevalue','value','cpm','cps']));
  if(!Number.isFinite(lat)||!Number.isFinite(lon)||!Number.isFinite(value)||Math.abs(lat)>90||Math.abs(lon)>180||value<0)return null;
  return {lat,lon,value,unit:pick(['unit','units'])||'µSv/h',time:pick(['time','timestamp','datetime','date'])||new Date().toISOString(),device:pick(['device','detector','model','note'])||'',note:pick(['note','notes'])||''};
}
function addToMap(r){
  const c=color(r.value);
  const m=L.circleMarker([r.lat,r.lon],{radius:6,color:c,fillColor:c,fillOpacity:.82,weight:1.3});
  m.bindPopup(`<div class="popupTitle">${escapeHtml(r.device||'Community reading')}</div><div class="popupValue">${escapeHtml(r.value)} ${escapeHtml(r.unit||'')}</div><div class="popupMeta">${new Date(r.time||Date.now()).toLocaleString()}<br>Lat ${Number(r.lat).toFixed(5)} • Lon ${Number(r.lon).toFixed(5)}</div>`);
  m.addTo(layer);
}
function rebuild(){
  layer.clearLayers();readings.forEach(addToMap);
  document.getElementById('cloudCount').textContent=readings.length;
  document.getElementById('lastSync').textContent=supabase?'CLOUD SYNCED':'LOCAL DATA';
}
function fit(){
  if(!readings.length){toast('No readings in the shared dataset yet.');return}
  map.fitBounds(L.latLngBounds(readings.map(r=>[r.lat,r.lon])),{padding:[35,35],maxZoom:15});
}
async function loadCloud(){
  if(!supabase)return;
  document.getElementById('dbState').textContent='Loading…';
  const {data,error}=await supabase.from('radiation_readings').select('id,lat,lon,value,unit,measured_at,device,note').order('measured_at',{ascending:true}).limit(20000);
  if(error){document.getElementById('dbState').textContent='Error';toast('Cloud read failed: '+error.message);return}
  readings=(data||[]).map(r=>({id:r.id,lat:r.lat,lon:r.lon,value:r.value,unit:r.unit,time:r.measured_at,device:r.device,note:r.note}));
  document.getElementById('dbState').textContent='Connected';
  rebuild();fit();document.getElementById('onlineText').textContent='CLOUD';document.getElementById('rtState').textContent='Connected';toast(`Loaded ${readings.length} shared readings.`);
}
async function connectCloud(){
  try{
    if(!supabase) supabase=window.supabase.createClient(PROJECT_URL,PUBLISHABLE_KEY);
    const sess=await supabase.auth.getSession();
    if(!sess.data.session){
      const sign=await supabase.auth.signInAnonymously();
      if(sign.error)throw sign.error;
    }
    subscribeRealtime();await loadCloud();
    document.getElementById('status').textContent='CLOUD ONLINE';
    toast('Cloud connected.');
  }catch(e){document.getElementById('status').textContent='SETUP REQUIRED';document.getElementById('dbState').textContent='Anonymous sign-in needs enabling';toast('Enable Anonymous Sign-Ins in Supabase Auth.');console.error(e)}
}
function subscribeRealtime(){
  if(realtimeChannel||!supabase)return;
  realtimeChannel=supabase.channel('radscope-radiation')
    .on('postgres_changes',{event:'INSERT',schema:'public',table:'radiation_readings'},payload=>{
      const r={id:payload.new.id,lat:payload.new.lat,lon:payload.new.lon,value:payload.new.value,unit:payload.new.unit,time:payload.new.measured_at,device:payload.new.device,note:payload.new.note};
      if(!readings.some(x=>x.id===r.id)){readings.push(r);addToMap(r);document.getElementById('cloudCount').textContent=readings.length;document.getElementById('lastSync').textContent='NEW READING RECEIVED';setTimeout(()=>document.getElementById('lastSync').textContent='CLOUD SYNCED',1800)}
    }).subscribe(status=>{document.getElementById('rtState').textContent=status==='SUBSCRIBED'?'Connected':status});
}
function csvParse(text){
  const lines=text.trim().split(/\r?\n/);if(!lines.length)return [];
  const sep=lines[0].includes('\t')?'\t':',';const headers=lines[0].split(sep).map(x=>x.trim().replace(/^["']|["']$/g,''));
  return lines.slice(1).map(line=>{
    const vals=[];let cur='',q=false;
    for(const ch of line){if(ch==='"'){q=!q;continue}if(ch===sep&&!q){vals.push(cur);cur=''}else cur+=ch}vals.push(cur);
    const obj={};headers.forEach((h,i)=>obj[h]=vals[i]??'');return normalizeRow(obj)
  }).filter(Boolean);
}
async function uploadRows(rows){
  if(!supabase){toast('Connect the cloud first.');return}
  const session=(await supabase.auth.getSession()).data.session;
  if(!session){toast('Cloud session is unavailable.');return}
  const payload=rows.map(r=>({user_id:session.user.id,lat:r.lat,lon:r.lon,value:r.value,unit:r.unit,measured_at:new Date(r.time).toISOString(),device:r.device,note:r.note}));
  const {error}=await supabase.from('radiation_readings').insert(payload);
  if(error){toast('Upload failed: '+error.message);return}
  toast(`Uploaded ${rows.length} readings.`);await loadCloud();
}
async function importFile(file){
  try{
    const text=await file.text();let rows=[];
    if(file.name.toLowerCase().endsWith('.json')){const j=JSON.parse(text);const arr=Array.isArray(j)?j:(j.readings||j.measurements||j.data||[]);rows=arr.map(normalizeRow).filter(Boolean)}
    else rows=csvParse(text);
    if(!rows.length){toast('No usable readings found.');return}
    await uploadRows(rows);
  }catch(e){toast('Could not parse that file.');console.error(e)}
}
async function addManual(){
  const r=normalizeRow({lat:document.getElementById('lat').value,lon:document.getElementById('lon').value,radiation:document.getElementById('rad').value,unit:document.getElementById('unit').value,device:document.getElementById('device').value});
  if(!r){toast('Enter valid coordinates and a non-negative reading.');return}
  await uploadRows([r]);map.setView([r.lat,r.lon],15);
}
function csvExport(){
  const head='latitude,longitude,radiation,unit,time,device,note\n';
  const body=readings.map(r=>[r.lat,r.lon,r.value,r.unit,r.time,r.device,r.note].map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob=new Blob([head+body],{type:'text/csv'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='radscope_shared_readings.csv';a.click();URL.revokeObjectURL(a.href)
}
document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));document.getElementById(b.dataset.screen).classList.add('active');b.classList.add('active');setTimeout(()=>map.invalidateSize(),50)});
document.getElementById('fileInput').onchange=e=>e.target.files[0]&&importFile(e.target.files[0]);
document.getElementById('addManual').onclick=addManual;
document.getElementById('fit').onclick=fit;
document.getElementById('refresh').onclick=loadCloud;
document.getElementById('locate').onclick=()=>map.locate({setView:true,maxZoom:14});
map.on('locationfound',()=>toast('Map centered on your location.'));map.on('locationerror',()=>toast('Location access unavailable.'));
document.getElementById('goData').onclick=()=>document.querySelector('nav button[data-screen="dataScreen"]').click();
document.getElementById('export').onclick=csvExport;document.getElementById('downloadCsv').onclick=csvExport;
document.getElementById('sample').onclick=()=>{
  const c=map.getCenter();
  document.getElementById('lat').value=c.lat.toFixed(6);document.getElementById('lon').value=c.lng.toFixed(6);document.getElementById('rad').value='0.11';document.getElementById('device').value='Sample';
  document.querySelector('nav button[data-screen="dataScreen"]').click();
  toast('Sample fields filled — press SAVE TO SHARED MAP.');
};
document.getElementById('connect').onclick=connectCloud;
document.getElementById('disconnect').onclick=()=>{if(realtimeChannel&&supabase) supabase.removeChannel(realtimeChannel);realtimeChannel=null;supabase=null;document.getElementById('status').textContent='CLOUD OFFLINE';document.getElementById('dbState').textContent='Local mode';document.getElementById('rtState').textContent='Off';toast('Switched to local/offline mode.')};

(async()=>{
  document.getElementById('onlineText').textContent='CONNECTING';
  document.getElementById('status').textContent='CLOUD CONNECTING';
  document.getElementById('dbState').textContent='Connecting…';
  try{
    supabase=window.supabase.createClient(PROJECT_URL,PUBLISHABLE_KEY);
    const sess=await supabase.auth.getSession();
    if(!sess.data.session){
      const sign=await supabase.auth.signInAnonymously();
      if(sign.error) throw sign.error;
    }
    subscribeRealtime();
    await loadCloud();
    document.getElementById('status').textContent='CLOUD ONLINE';
  }catch(e){
    console.error(e);
    document.getElementById('status').textContent='SETUP REQUIRED';
    document.getElementById('onlineText').textContent='OFFLINE';
    document.getElementById('dbState').textContent='Anonymous sign-in needs enabling';
    document.getElementById('rtState').textContent='Off';
    document.getElementById('setupOverlay').style.display='flex';
  }
})();
</script>
</body>
</html>
